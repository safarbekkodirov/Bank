<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot parent POM:
        бул бизге Java 21, библиотекалардын версияларын, test жана build
        конфигурациясын автоматтык түзүп берет.
        Версијаны өзгөртүүнү башкарабыз — ошол эле жерден.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.minibank</groupId>
    <artifactId>minibank</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>minibank</name>
    <description>Educational banking REST API (learning project, not a real bank)</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.13.0</jjwt.version>

        <!-- PHASE 10A: OpenAPI 3 + Swagger UI.
             2.8.x — Spring Boot 3.5.x менен иштейт (2.8.17 Spring Boot 3.5.x
             негизде курулган, биз 3.5.16 колдонобуз — бирдей 3.5 сызыгы).
             3.x сериясы Spring Boot 4.x үчүн, ошондуктан ЭМЕС колдонобуз. -->
        <springdoc.version>2.8.17</springdoc.version>
    </properties>

    <dependencies>

        <!-- Spring Web: REST API үчүн (Controller + JSON сериализация) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA/Hibernate: Java класстары менен SQL таблицаларын байланыштырат -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC айкөкчүсү (runtime: иштетирүү учурунда гана керек) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: DB схемасын версия менен башкарат (таблицаларды ОЗУ түзөт) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway 10+ PostgreSQL колдогону POS айкөкчүсүнө бөлүнгөн.
             Бул китепкананы кошпосо Flyway PostgreSQL'ге коно албайт. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Валидация: @NotBlank / @Email / @Size (Jakarta Bean Validation).
             Spring Boot 2.3+дан бери бул АЙЛАМПА web ичине киргизбейт,
             аны атайын кошуш керек. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- BCrypt үчүн МИНИМАЛДУУ китепкана.
             Бул атайын "security-crypto": Spring Security'нин crypto бөлүмү гана.
             Ал BCryptPasswordEncoder КЛАССИН БЕРЕТ, бирок HTTP коопсуздук
             чыпкаларын (SecurityConfig, filter chain) күйгүзбөй.
             Ошондуктан 3A этапында колдонмокум ачык турат, токтотулбайт. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Spring Security: чыныгы HTTP коопсуздук чыпкалары (3B+).
             Бул азыр BCrypt гана эмес, толук фильтр-чөйрөнү берет.
             Биз АНЫН ӨЗ SecurityConfig'ибизди жазабыз — Spring'дин
             демкилгизди киргизиш бетинен (form login) баш тартабыз. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JJWT — JWT токенди жасоо жана текшерүү үчүн.
             Spring Boot бул китепкананы башкарбайт, ошондуктан
             версияны МЫКТЫҮН өзүбүз жазабыз.

             -jjwt-api   : compile — биз колдонгон класстар (Jwts, Claims)
             -jjwt-impl  : runtime — JJWT'нин өз иштеп жүгүнү
             -jjwt-jackson: runtime — аны JSON менен байланыштыруучу
             Spring Boot 3.x => Jakarta (javax эМЕС). JJWT 0.12+ ушул стандартка өттү. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- PHASE 10A: OpenAPI 3 + Swagger UI.
             -springdoc-openapi-starter-webmvc-ui : автоматтык түзүмдө
              (/v3/api-docs) + Swagger UI (/swagger-ui/index.html).
             Бул китепкана БИЗДИН SecurityConfig'ти ОЗГӨРТМӨЙТ — ал
             так коопсуздук эмес, так ДОКУМЕНТАЦИЯ. Биз SecurityConfig'те
             аларга ачык жол ачып беребиз (swagger чейинги конфигурация). -->
        <!-- PHASE 10C: OBSERVABILITY (health / metrics).
             Бул китепкана бизге ҮСТҮНДӮ 3 нерсени берет:
               1. /actuator/health  — колдонмо + PostgreSQL жашалчылыгы
               2. /actuator/metrics — Spring Boot'тун өз метрикалары
                  (http.server.requests, jvm.*, hikaricp.*)
               3. /actuator/info    — build/versiya маалыматы (бош)
             🔴 ВЕРСИЯНЫ БИЗ ЖАЗМАЙБЫЗ: «spring-boot-starter-parent»
             аны башкарады (Spring Boot 3.5.x сызыгы). Демек Spring Boot
             жаңы версияга которулганда биздин pom да так эле аны менен
             бирге өсөт — «версияны унутуп, эски күткөнүбүз» деген
             тоболук чыкмайды. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- JUnit 5 + AssertJ + Mockito + Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Security тесттери үчүн: @WithMockUser, securityMockMvc() -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- ./mvnw spring-boot:run жана ./mvnw package үчүн -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
