<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot parent POM:
        бул бизге Java 21, библиотекалардын версияларын, test жана build
        конфигурациясын автоматтык түзүп берет.
        Версијаны өзгөртүүнү башкарабыз — ошол эле жерден.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.minibank</groupId>
    <artifactId>minibank</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>minibank</name>
    <description>Educational banking REST API (learning project, not a real bank)</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- Spring Web: REST API үчүн (Controller + JSON сериализация) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA/Hibernate: Java класстары менен SQL таблицаларын байланыштырат -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- PostgreSQL JDBC айкөкчүсү (runtime: иштетирүү учурунда гана керек) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: DB схемасын версия менен башкарат (таблицаларды ОЗУ түзөт) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!-- Flyway 10+ PostgreSQL колдогону POS айкөкчүсүнө бөлүнгөн.
             Бул китепкананы кошпосо Flyway PostgreSQL'ге коно албайт. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Валидация: @NotBlank / @Email / @Size (Jakarta Bean Validation).
             Spring Boot 2.3+дан бери бул АЙЛАМПА web ичине киргизбейт,
             аны атайын кошуш керек. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- BCrypt үчүн МИНИМАЛДУУ китепкана.
             Бул атайын "security-crypto": Spring Security'нин crypto бөлүмү гана.
             Ал BCryptPasswordEncoder КЛАССИН БЕРЕТ, бирок HTTP коопсуздук
             чыпкаларын (SecurityConfig, filter chain) күйгүзбөй.
             Ошондуктан 3A этапында колдонмокум ачык турат, токтотулбайт. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JUnit 5 + AssertJ + Mockito + Spring Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- ./mvnw spring-boot:run жана ./mvnw package үчүн -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
