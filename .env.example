# ============================================================
#  ЧАРА ЖЫЙЫНДЫН (.env) КОПИЯСЫ — ЧЫНЫГЫ СЫР ЭМЕС
# ============================================================
#  Жаңы компьютерде иштеш үчүн:
#      cp .env.example .env
#  андан .env ичиндеги "change-me" жагдаштарын өзүңкүнө оңдүрүп,
#  кийин:  docker compose up -d
# ============================================================

# --- PostgreSQL контейнери үчүн ---
POSTGRES_DB=minibank
POSTGRES_USER=minibank
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Spring Boot колдонмосу үчүн (Phase 3+да колдонулат) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=minibank
DB_USERNAME=minibank
DB_PASSWORD=change-me

# --- JWT сыры (Phase 3'те колдонулат) ---
# ⚠️ Сыр КЕЗДЕ 32 байттан ЧОҢ болушу керек (HS256 -> 256 бит).
#   Мисалы, рандом жаңы сыр түзүү:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes-long
JWT_ACCESS_TOKEN_EXPIRATION=15m
